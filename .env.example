# Juntta Feria - local development template (ADR 0004).
# Safe to commit: no usable secrets. Create your local .env with:
#   node scripts/init-local-env.mjs
# The script replaces every GENERATE_LOCAL_HEX_64 marker with a unique secret,
# keeps the values you already have in .env and rebuilds DATABASE_URL.
# Never reuse local values in staging or production.

# Application
NODE_ENV=development
API_HOST=0.0.0.0
PORT=3000
API_PREFIX=api/v1
WEB_PORT=4200
# Development proxy only (Angular dev server); browser code always uses /api/v1.
API_PROXY_TARGET=http://localhost:3000
# Comma-separated allowlist. Production rejects "*".
CORS_ORIGINS=http://localhost:4200
LOG_LEVEL=debug
# Development only. Production rejects true.
SWAGGER_ENABLED=true

# PostgreSQL/PostGIS
POSTGRES_DB=juntta_feria_local
POSTGRES_USER=juntta_local
# Hexadecimal secret so DATABASE_URL needs no URL encoding.
POSTGRES_PASSWORD=GENERATE_LOCAL_HEX_64
# Host port. Use 5433 if a PostgreSQL installed on the host already owns 5432.
POSTGRES_PORT=5432
# Rebuilt by the init script from the POSTGRES_* values (localhost).
DATABASE_URL=postgresql://juntta_local:GENERATE_LOCAL_HEX_64@localhost:5432/juntta_feria_local
DB_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379

AUTH_PASSWORD_ENABLED=false
S3_PUBLIC_ENDPOINT=
TRUST_PROXY=0
PUBLIC_RATE_LIMIT=120
PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
WEBHOOK_RATE_LIMIT=600
DOCUMENT_UPLOAD_TTL_MINUTES=60

 

# LocalStack S3-compatible local storage
S3_ENDPOINT=http://localhost:4566
S3_REGION=us-east-1
S3_BUCKET=juntta-feria-local
# Public credentials defined by LocalStack for local simulation only.
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_FORCE_PATH_STYLE=true

# Authentication contract reserved for CORE-02 (not read by the API yet).
AUTH_ACCESS_TOKEN_SECRET=GENERATE_LOCAL_HEX_64
AUTH_REFRESH_TOKEN_SECRET=GENERATE_LOCAL_HEX_64
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_REFRESH_COOKIE_NAME=juntta_refresh
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax


# Reservation policy reserved for RES-01.
RESERVATION_HOLD_TTL_SECONDS=900

# Mercado Pago contract reserved for PAY-01.
# Left empty on purpose: set your own sandbox credentials only when testing payments.
MP_ENVIRONMENT=sandbox
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

GOOGLE_CLIENT_ID=xxx 
MP_CHECKOUT_API=preferences
# Optional observability integrations (empty = disabled).
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
