# Local development only. Copy to .env and replace every REPLACE_* value.
# Use unique URL-safe hexadecimal secrets (for example, 64 hex characters).
# Never use these local credentials in staging or production.
NODE_ENV=development
PORT=3000
WEB_PORT=4200
CORS_ORIGIN=http://localhost:4200

POSTGRES_DB=feriaos
POSTGRES_USER=feriaos
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHAR_SECRET
DATABASE_URL=postgresql://feriaos:REPLACE_WITH_64_HEX_CHAR_SECRET@localhost:5432/feriaos
REDIS_URL=redis://localhost:6379

MINIO_ROOT_USER=REPLACE_WITH_LOCAL_MINIO_USER
MINIO_ROOT_PASSWORD=REPLACE_WITH_64_HEX_CHAR_SECRET
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=feriaos-local
# For local development, set these to the same values as MINIO_ROOT_USER/PASSWORD.
S3_ACCESS_KEY=REPLACE_WITH_LOCAL_MINIO_USER
S3_SECRET_KEY=REPLACE_WITH_64_HEX_CHAR_SECRET
S3_FORCE_PATH_STYLE=true

# Keep empty until Mercado Pago sandbox credentials and webhook signing are configured.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_ENVIRONMENT=sandbox

# Optional observability integrations.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Reserved for JWT authentication if selected in the auth strategy decision.
JWT_SECRET=REPLACE_WITH_64_HEX_CHAR_SECRET
