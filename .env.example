# Juntta Feria - simulated local development configuration.
# These values are public, fictitious and restricted to loopback-bound services.
# Never reuse them in staging or production. Generate unique secrets outside Git.

# Application
NODE_ENV=development
API_HOST=0.0.0.0
PORT=3000
API_PREFIX=api/v1
WEB_PORT=4200
API_PROXY_TARGET=http://localhost:3000
CORS_ORIGIN=http://localhost:4200
CORS_ORIGINS=http://localhost:4200
LOG_LEVEL=debug
SWAGGER_ENABLED=true

# PostgreSQL/PostGIS
POSTGRES_DB=juntta_feria_local
POSTGRES_USER=juntta_local
# Public simulation value: hexadecimal so DATABASE_URL needs no URL encoding.
POSTGRES_PASSWORD=6a756e7474615f6c6f63616c5f706f7374677265735f6578616d706c655f3031
POSTGRES_PORT=5432
DATABASE_URL=postgresql://juntta_local:6a756e7474615f6c6f63616c5f706f7374677265735f6578616d706c655f3031@localhost:5432/juntta_feria_local
DB_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379

# LocalStack S3-compatible local storage
S3_ENDPOINT=http://localhost:4566
S3_REGION=us-east-1
S3_BUCKET=juntta-feria-local
# Public credentials defined by LocalStack for local simulation only.
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_FORCE_PATH_STYLE=true

# Authentication contract reserved for CORE-02.
# Public simulation values; functional environments must generate unique secrets.
AUTH_ACCESS_TOKEN_SECRET=6a756e7474615f6c6f63616c5f6163636573735f6578616d706c655f30303031
AUTH_REFRESH_TOKEN_SECRET=6a756e7474615f6c6f63616c5f726566726573685f6578616d706c655f303031
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_REFRESH_COOKIE_NAME=juntta_refresh
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# Reservation policy reserved for RES-01.
RESERVATION_HOLD_TTL_SECONDS=900

# Mercado Pago contract reserved for PAY-01.
# Deliberately invalid simulated identifiers: they cannot authorize real requests.
MP_ENVIRONMENT=sandbox
MP_ACCESS_TOKEN=TEST-SIMULATED-JUNTTA-FERIA-NOT-A-VALID-TOKEN
MP_WEBHOOK_SECRET=SIMULATED-JUNTTA-FERIA-NOT-A-VALID-WEBHOOK-SECRET

# Optional observability integrations.
# The Sentry DSN is deliberately invalid; OTLP points to a future local collector.
SENTRY_DSN=https://simulated-public-key@localhost/0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
